# Copy to .env.local for local development. NEVER commit real values.

# Final public URL (no trailing slash). Enables canonical URLs, sitemap and Open Graph absolute URLs.
# Leave empty until the domain is known.
NEXT_PUBLIC_SITE_URL=

# Business contact details. Leave empty until the owner confirms them; the site shows "to be added".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Payment gateway (future). Server-side only — never prefix with NEXT_PUBLIC_.
# Checkout stays disabled ("not configured") while these are empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
